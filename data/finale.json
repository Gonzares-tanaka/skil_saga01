{
  "lore": {
    "B11_01": {
      "floor": 11,
      "tile": [21, 0],
      "lines": [
        "われらはアムリタと共に",
        "この地に生きた。",
        "その光は命をつないだ。"
      ]
    },
    "B12_01": {
      "floor": 12,
      "tile": [22, 0],
      "lines": [
        "地上より来た者たちは",
        "われらの光を欲した。",
        "交わした言葉は失われた。"
      ]
    },
    "B12_02": {
      "floor": 12,
      "tile": [23, 0],
      "lines": [
        "光を守る扉を閉ざした。",
        "それでも地上の剣は",
        "奥へ、奥へと押し寄せた。"
      ]
    },
    "B13_01": {
      "floor": 13,
      "tile": [24, 0],
      "lines": [
        "王冠を戴く者は",
        "アムリタを地上へ持ち去った。",
        "その名は削られている。"
      ]
    },
    "B14_01": {
      "floor": 14,
      "tile": [25, 0],
      "lines": [
        "地上では『王の秘宝』と呼ぶ。",
        "ここでは『奪われた光』と記す。",
        "同じ光を指すのだろうか。"
      ]
    },
    "B14_02": {
      "floor": 14,
      "tile": [26, 0],
      "lines": [
        "光は再び深淵に戻った。",
        "地上への憎しみだけが",
        "この門の奥に残っている。"
      ]
    }
  },
  "guardian_ids": ["sentinel_armor", "sentinel_speed", "sentinel_mind"],
  "guardian_warning": [
    "この先から",
    "強い気配を感じる……。",
    "三つの影が道を塞いでいる。",
    "連戦では技の回数も戻らない。",
    "進む前なら、まだ帰還できる。"
  ],
  "guardian_between": [
    [
      "重装の守護者が倒れた。",
      "息をつく間もなく、",
      "次の影が迫ってくる。"
    ],
    [
      "高速の守護者が倒れた。",
      "奥から魔力が満ちてくる。",
      "これが最後の守護者だ。"
    ]
  ],
  "guardian_after": [
    "最後の守護者が崩れ落ちた。",
    "奥への道が開いた。",
    "泉は傷だけを癒す。",
    "使った技の回数は戻らない。"
  ],
  "demon_after": [
    "デーモンは倒れた。",
    "古い記録が真相を語る。",
    "アムリタは元々、",
    "デーモンたちのものだった。",
    "過去に王国がそれを奪い、",
    "地上へ持ち去っていた。",
    "『王国の秘宝を盗んだ魔物』。",
    "王の話は歴史の一面にすぎない。",
    "だがデーモンもまた、",
    "人間を滅ぼそうとしていた。",
    "危険な敵に変わりはなかった。",
    "アムリタを手に入れた。",
    "拠点へ帰還できる。"
  ],
  "return_locked": [
    "連戦の最中だ。",
    "今はRETURNで帰還できない。"
  ]
